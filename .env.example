# Malenge Farmers CRM environment example
# Copy this file to .env locally and replace every placeholder.

DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/malenge_farmers_crm
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# Local development defaults
APP_ENV=development
SESSION_COOKIE_SECURE=false
TRUST_PROXY_HEADERS=false
ALLOW_BOOTSTRAP_REGISTRATION=true

# Login throttling
LOGIN_FAILURE_WINDOW_SECONDS=900
LOGIN_MAX_FAILURES_PER_ACCOUNT=5
LOGIN_MAX_FAILURES_PER_IP=20

# Maximum request size in bytes (default: 16 MiB)
MAX_CONTENT_LENGTH=16777216

# Google Authenticator two-factor authentication
TWO_FACTOR_REQUIRED=true
TWO_FACTOR_ISSUER=Malenge Farmers CRM
TWO_FACTOR_MAX_ATTEMPTS=5

# Phase 6: optional persistent evidence directory. Leave blank/unset for local instance/accountability_uploads.
# On production hosting, point this to a persistent disk/mount.
# ACCOUNTABILITY_UPLOAD_DIR=/var/data/malenge/accountability_uploads
